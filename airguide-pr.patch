+    });
+    alertSelect.addEventListener("change", function () {
+      alertCfg.threshold = parseInt(alertSelect.value, 10) || 151;
+      alertedNow = false;
+      store(ALERT_KEY, alertCfg);
+      if (alertCfg.on && lastLiveData) checkAlert(lastLiveData, levelIndex(lastLiveData.aqi));
+    });
+  }
